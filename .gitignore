# Dependencies
node_modules/
.pnp.*

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Env & secrets — never commit (Secret Manager only)
.env
.env.*
!.env.example

# Prisma
packages/db/prisma/*.db
packages/db/prisma/*.db-journal

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code — personal/local settings (shared settings.json may be committed)
.claude/settings.local.json

# Terraform
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/*.tfvars
!infra/terraform/**/*.tfvars.example
infra/terraform/**/backend.hcl

# Test coverage
coverage/

# Rust (Siphon-AI gateway)
voice/**/target/

# up.sh downloads the Cloud SQL Auth Proxy here (~32 MB). A tool binary, not
# source, and it is re-fetched whenever it is missing.
.cache/
