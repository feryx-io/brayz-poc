# Brayz local environment — copy to .env and fill in.
# NEVER commit a real .env. In GCP, all secrets come from Secret Manager.
# All vars are validated by @brayz/config (Zod). Do not read process.env elsewhere.

NODE_ENV=development

# Postgres (system of record) — Cloud SQL in GCP, local Postgres for dev
DATABASE_URL=postgresql://brayz:brayz@localhost:5432/brayz?schema=public

# Redis / Memorystore (ephemeral hot state only)
REDIS_URL=redis://localhost:6379

# GCP
GCP_PROJECT_ID=brayz-dev
PUBSUB_TOPIC_CALL_EVENTS=call-events

# Twilio (first PSTN carrier — behind CarrierProvider abstraction)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# AI providers (behind provider interfaces)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Shared secret signing Siphon-AI <-> Brayz node requests
BRAYZ_NODE_SHARED_SECRET=dev-only-change-me

# Stripe billing. Leave blank to run without billing entirely.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Set true once real plans exist to make tiers actually gate features.
BILLING_ENFORCED=false

# Object storage holding call recordings (S3-compatible: GCS interop, S3, R2,
# MinIO). Must match SiphonAI's [recording.storage]. Without these the dashboard
# shows a recording exists but cannot play it.
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=auto
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=

# HMAC secret for SiphonAI lifecycle webhooks ([webhooks].secret on the node).
# Leave blank to refuse them entirely; must be >= 16 chars to enable the endpoint.
SIPHON_WEBHOOK_SECRET=

# Internal API base URL (Orchestrator/worker -> API)
API_INTERNAL_URL=http://localhost:4000

# Auth. `dev` = trust headers (local). `firebase` = verify Firebase ID tokens.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=brayz-dev

# Service ports (local dev)
API_PORT=4000
ORCHESTRATOR_PORT=4100
WEB_PORT=3000

# --- Web (apps/web) — Next.js reads NEXT_PUBLIC_* directly, not via @brayz/config ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_MODE=dev
# Public Firebase web config (from the Firebase console, brayz-dev). Not secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=brayz-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=brayz-dev
