# Deploy-time settings for brayz-dev, sourced by infra/scripts/deploy-cloud-run.sh.
# Public values only — the Firebase web config ships to every browser in the web
# bundle. Secrets stay in Secret Manager. Without this file the script defaults to
# WEB_AUTH_MODE=dev, which with an API in firebase mode leaves the portal unable
# to sign anyone in.
WEB_AUTH_MODE=firebase
FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=brayz-dev.firebaseapp.com
FIREBASE_PROJECT_ID=brayz-dev
